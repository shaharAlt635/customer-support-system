# ---------------------------------------------------------------------------
# Support Desk API — environment configuration
# Copy to `apps/server/.env` (or run `npm run setup` from the repo root, which
# also generates a random JWT secret for you).
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# MongoDB connection string. MongoDB MUST run as a replica set (Prisma uses
# transactions). Works with `npm run db:local`, `docker compose up -d` and Atlas.
#   Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/support_desk
DATABASE_URL="mongodb://127.0.0.1:27017/support_desk?directConnection=true"

# Secret used to sign access tokens. Use at least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:5173
# Defaults to true when NODE_ENV=production. Requires HTTPS.
# COOKIE_SECURE=true
# strict (default) | lax | none — use `none` (with HTTPS) only if the web app is
# hosted on a different site than the API.
COOKIE_SAME_SITE=strict
# Set to true when running behind a reverse proxy / load balancer.
TRUST_PROXY=false

# Allow visitors to create new companies at /signup.
ALLOW_COMPANY_SIGNUP=true
# Allow visitors to register customer accounts on a company's page.
ALLOW_REGISTRATION=true

# Public URL of the web app — used to build links in emails.
APP_URL=http://localhost:5173

# Email delivery:
#   dev  — emails are stored in MongoDB and shown at http://localhost:5173/dev/mailbox
#          (default outside production; never exposed in production)
#   smtp — real delivery via any SMTP provider (default and required in production)
# EMAIL_TRANSPORT=dev
EMAIL_FROM="Support Desk <no-reply@example.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465
# SMTP_USER=
# SMTP_PASS=

# Attachments (stored on local disk)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
MAX_FILES_PER_UPLOAD=5

# Requests per minute per IP (global) and for sign-in/registration endpoints.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Human check (Cloudflare Turnstile, free) on public forms: company sign-up, registration,
# public ticket requests, "find my company", forgot password and sign-in links.
# Off when empty. Create keys at https://dash.cloudflare.com/?to=/:account/turnstile
# For local testing, Cloudflare's dummy keys always pass:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Serve the built React app (apps/web/dist) from this server in production.
SERVE_WEB=false
WEB_DIST_DIR=../web/dist

# Attachments: "disk" (UPLOAD_DIR) or "database" (MongoDB; the default on Vercel, which has
# no persistent disk). On Vercel, MAX_UPLOAD_SIZE_MB defaults to 4 (4.5 MB request limit).
# FILE_STORAGE=disk

# Public portfolio demo: keeps the dev mailbox (/dev/mailbox) and the demo logins on in
# production, and the daily job resets the database to the demo data. Every email is
# visible to every visitor, so never enable it for real users.
DEMO_MODE=false
# Enables GET /api/cron/daily (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
