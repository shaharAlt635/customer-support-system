# ---------------------------------------------------------------------------
# Support Desk API — environment configuration
# Copy to `apps/server/.env` (or run `npm run setup` from the repo root, which
# also generates a random JWT secret for you).
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# MongoDB connection string. MongoDB MUST run as a replica set (Prisma uses
# transactions). Works with `npm run db:local`, `docker compose up -d` and Atlas.
#   Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/support_desk
DATABASE_URL="mongodb://127.0.0.1:27017/support_desk?directConnection=true"

# Secret used to sign access tokens. Use at least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:5173
# Defaults to true when NODE_ENV=production. Requires HTTPS.
# COOKIE_SECURE=true
# strict (default) | lax | none — use `none` (with HTTPS) only if the web app is
# hosted on a different site than the API.
COOKIE_SAME_SITE=strict
# Set to true when running behind a reverse proxy / load balancer.
TRUST_PROXY=false

# Allow visitors to create customer accounts themselves.
ALLOW_REGISTRATION=true

# Attachments (stored on local disk)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
MAX_FILES_PER_UPLOAD=5

# Requests per minute per IP (global) and for sign-in/registration endpoints.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Serve the built React app (apps/web/dist) from this server in production.
SERVE_WEB=false
WEB_DIST_DIR=../web/dist
