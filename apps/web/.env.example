# Base URL of the API as seen by the browser. Keep the default (`/api`) when the API is
# served from the same origin — through the Vite dev proxy or with SERVE_WEB=true.
VITE_API_URL=/api

# Show one-click demo account buttons on the sign-in page in production builds
# (always shown in development). Only enable for public demo deployments.
VITE_SHOW_DEMO_ACCOUNTS=false

# Dev server only: where the Vite proxy forwards /api requests.
API_PROXY_TARGET=http://localhost:4000
WEB_PORT=5173
